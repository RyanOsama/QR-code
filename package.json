{
  "name": "event-qr-manager",
  "version": "1.0.0",
  "type": "module",
  "description": "نظام إدارة دعوات المناسبات وتأكيد الدخول عبر QR Code",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "vite",
    "start": "electron .",
    "test": "tsx src/tests/systemTest.ts && tsx src/tests/pdfVerificationTest.ts && tsx src/tests/graduateAllocationAndFilterTest.ts && tsx src/tests/presetDuplexTest.ts && tsx src/tests/cardAlignmentAndEventDetailsTest.ts && tsx src/tests/customImageOutpaintTest.ts && tsx src/tests/deploymentAndLicensingTest.ts && tsx src/tests/commercialLicensingAndSaaSTest.ts && tsx src/tests/saasSubscriptionFlowTest.ts && tsx src/tests/superAdminManagementTest.ts && tsx src/tests/dedicatedFirstRunSetupTest.ts && tsx src/tests/dedicatedDatabaseProvisioningTest.ts && tsx src/tests/dedicatedOnboardingTest.ts && tsx src/tests/dedicatedMigrationTest.ts && tsx src/tests/licenseServerIntegrationTest.ts && tsx src/tests/licenseAndDeviceManagementTest.ts && tsx src/tests/securityHardeningTest.ts && tsx src/tests/finalProductionVerificationTest.ts",
    "test:final-production": "tsx src/tests/finalProductionVerificationTest.ts",
    "test:security": "tsx src/tests/securityHardeningTest.ts",
    "test:super-admin": "tsx src/tests/superAdminManagementTest.ts",
    "test:saas-subscription": "tsx src/tests/saasSubscriptionFlowTest.ts",
    "test:system": "tsx src/tests/systemTest.ts",
    "test:pdf": "tsx src/tests/pdfVerificationTest.ts",
    "test:graduates": "tsx src/tests/graduateAllocationAndFilterTest.ts",
    "test:licensing": "tsx src/tests/deploymentAndLicensingTest.ts",
    "test:commercial": "tsx src/tests/commercialLicensingAndSaaSTest.ts",
    "test:firstrun": "tsx src/tests/dedicatedFirstRunSetupTest.ts",
    "test:provisioning": "tsx src/tests/dedicatedDatabaseProvisioningTest.ts",
    "test:onboarding": "tsx src/tests/dedicatedOnboardingTest.ts",
    "test:migration": "tsx src/tests/dedicatedMigrationTest.ts",
    "test:license-integration": "tsx src/tests/licenseServerIntegrationTest.ts",
    "test:license-mgmt": "tsx src/tests/licenseAndDeviceManagementTest.ts",
    "build:win": "tsc && vite build && npx electron-builder --win --config.npmRebuild=false"
  },
  "build": {
    "appId": "com.event.qrmanager",
    "productName": "EventQRManager",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "dir"
      ]
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "electron",
    "qr",
    "events",
    "invitations",
    "wedding",
    "scanner"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.45.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
